[Unit]
Description=BonusPro verified encrypted offsite checkpoint
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
OnFailure=bonuspro-monitor.service

[Service]
Type=oneshot
User=root
UMask=0077
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=/usr/local/lib/bonuspro-ops
ExecStart=/usr/bin/python3 -E -s /usr/local/lib/bonuspro-ops/offsite_backup.py --config /etc/bonuspro-ops/config.json
TimeoutStartSec=7200
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/bonuspro-ops /home/ubuntu/bonuspro-backups
