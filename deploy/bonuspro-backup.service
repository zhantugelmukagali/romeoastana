[Unit]
Description=BonusPro encrypted PostgreSQL checkpoint
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
WorkingDirectory=/home/ubuntu/bonuspro-release
ExecStart=/usr/bin/python3 /home/ubuntu/bonuspro-release/scripts/backup_vps.py --image-from-env
TimeoutStartSec=1900
