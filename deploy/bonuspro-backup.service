[Unit]
Description=BonusPro encrypted PostgreSQL checkpoint
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
WorkingDirectory=/usr/local/lib/bonuspro-backup
ExecStart=/usr/bin/python3 /usr/local/lib/bonuspro-backup/backup_vps.py --image-from-env
TimeoutStartSec=1900
